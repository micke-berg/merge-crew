# Copy to .env.local for local development. Names only; never commit values.

# AI hints through the Vercel AI Gateway. On Vercel the project's OIDC token is used automatically.
# Locally, set one of these (or run `vercel env pull` to get VERCEL_OIDC_TOKEN). Without either,
# Tidy gives the scripted hints.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=

# Set to "off" to switch the AI hints off and always use the scripted hints.
HINTS_AI=

# Tracing of hint calls to Langfuse. Off unless both keys are set. LANGFUSE_BASE_URL is optional
# (the Langfuse SDK's default region is used when it is empty).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
